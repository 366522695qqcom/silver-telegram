NODE_ENV=development
PORT=3000

# 数据库 (Turso)
LIBSQL_URL=file:./local.db
LIBSQL_AUTH_TOKEN=

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# 管理员账户 (登录凭证)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password

# 前端 URL (本地开发)
FRONTEND_URL=http://localhost:5173

# 应用域名 (部署时设置，用于 CORS)
# 示例: mybiog.us.ci
APP_DOMAIN=

# 时区偏移 (小时，用于 SQL 查询中的"今日"计算)
# UTC+8 填 8，UTC-5 填 -5，默认 8
TZ_OFFSET=8

LOG_LEVEL=info
